#For a full list of backend/worker settings and their description, see common/settings.py
#
# This file is sourced by the shell (see `ENV_SH` in the Makefile), so quote any
# value containing spaces or shell metacharacters such as < > ; ( ) & |

DOCKER_BUILDER_CONTAINER=minute
APP_NAME=minute
ENVIRONMENT=local
APP_URL=http://localhost:3000
BACKEND_HOST=http://localhost:8080

# === AWS ===
# Local dev points boto3 at MiniStack via the standard AWS_* variables. Deployed
# environments inject the real values (endpoint unset; creds from the ECS task role).
AWS_DEFAULT_REGION=antarctica-west-2
AWS_ACCESS_KEY_ID=Penguin
AWS_SECRET_ACCESS_KEY=FeathersMcGraw
AWS_ENDPOINT_URL=http://localhost:4566
AWS_S3_BUCKET=i-dot-ai-dev-minute-data
# Makefile only (ECR login/push); leave unquoted. e.g. 123456789012
AWS_ACCOUNT_ID=
AWS_REGION=eu-west-2

# === Azure LLM config ===
AZURE_OPENAI_API_KEY="<>"
AZURE_OPENAI_ENDPOINT="<>"
AZURE_DEPLOYMENT="<>"
AZURE_OPENAI_API_VERSION="<>"

# === Azure transcription config ===
AZURE_SPEECH_KEY="<api key to access azure speech>"
AZURE_SPEECH_REGION="<region of azure speech>"
# optional extra Azure STT regions, tried in order when a region returns 429 or 5xx
AZURE_SPEECH_FALLBACK_1_KEY="<Azure STT speech key for fallback 1>"
AZURE_SPEECH_FALLBACK_1_REGION="<Azure STT speech region for fallback 1>"
AZURE_SPEECH_FALLBACK_2_KEY="<Azure STT speech key for fallback 2>"
AZURE_SPEECH_FALLBACK_2_REGION="<Azure STT speech region for fallback 2>"

# === Google cloud ===
GOOGLE_CLOUD_PROJECT="<>"
GOOGLE_CLOUD_LOCATION="<>"
GOOGLE_APPLICATION_CREDENTIALS=/app/config/google-credentials.json
GOOGLE_APPLICATION_CREDENTIALS_BASE64="<base64 encoded json of the above. only used in docker container>"


# === postgres ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=minute_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=insecure

# === queue service ===
LLM_QUEUE_NAME=minute-llm-queue
LLM_DEADLETTER_QUEUE_NAME=minute-llm-queue-deadletter

# === Temporal (transcription workflow); docker compose overrides the address ===
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# Max concurrent Azure STT calls per temporal-worker container (cluster cap = this x containers)
STT_MAX_CONCURRENCY=4
# Max concurrent LLM/DB steps (speakers, title, summary) per temporal-worker container
MAX_LLM_PROCESSES=1

# === required to authorise user ===
REPO=minute
AUTH_API_URL="<auth_api_url>"

# === other ===
# Leave empty to disable Sentry. A non-empty value must be a valid Sentry DSN.
SENTRY_DSN=""
POSTHOG_API_KEY="<>"
