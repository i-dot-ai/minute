    "@radix-ui/react-slot": "^1.2.3",
    "@sentry/nextjs": "^10.27.0",
    "@tanstack/react-query": "^5.80.7",
    "@tiptap/core": "^3.27.0",
    "@tiptap/extension-document": "^3.27.0",
    "@tiptap/extension-hard-break": "^3.27.0",
