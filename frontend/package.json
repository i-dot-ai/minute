{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:css && next dev",
    "build": "npm run build:css && next build",
    "build:css": "sass --load-path=node_modules --style=compressed --no-source-map styles/govuk.scss styles/govuk.css",
    "start": "next start",
    "lint": "next lint",
    "openapi-ts": "openapi-ts",
    "prettier:fix": "prettier --write .",
    "public-site": "npm run public-site:build && npx --yes serve dist -p 5000",
    "public-site:build": "npm run build:css && node scripts/build-public-site.mjs"
  },
